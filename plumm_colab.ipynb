# ------------------------------
# Step 1: Load model
# ------------------------------
from transformers import AutoTokenizer, AutoModelForCausalLM
import torch

print("Loading model, this may take a few minutes...")
tokenizer = AutoTokenizer.from_pretrained("CYFRAGOVPL/Llama-PLLuM-8B-chat")
model = AutoModelForCausalLM.from_pretrained(
    "CYFRAGOVPL/Llama-PLLuM-8B-chat",
    torch_dtype=torch.float16,
    device_map="auto"
)
print("Model loaded!")

# ------------------------------
# Step 2: Setup FastAPI server
# ------------------------------
from fastapi import FastAPI
from pydantic import BaseModel
import nest_asyncio
from pyngrok import ngrok

nest_asyncio.apply()  # allow nested asyncio in Colab

app = FastAPI()

class RequestBody(BaseModel):
    messages: list  # list of {"role": "user", "content": "..."}

@app.post("/generate")
def generate_text(body: RequestBody):
    # Tokenize input
    inputs = tokenizer.apply_chat_template(
        body.messages,
        add_generation_prompt=True,
        tokenize=True,
        return_dict=True,
        return_tensors="pt",
    ).to(model.device)

    # Generate output
    outputs = model.generate(**inputs, max_new_tokens=128)
    response = tokenizer.decode(outputs[0][inputs["input_ids"].shape[-1]:])
    return {"response": response}

# ------------------------------
# Step 3: Expose API via ngrok
# ------------------------------
public_url = ngrok.connect(8000)
print(f"🚀 API URL (use from local machine): {public_url}")

# ------------------------------
# Step 4: Run server
# ------------------------------
import uvicorn

uvicorn.run(app, host="0.0.0.0", port=8000)
